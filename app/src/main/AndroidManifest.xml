<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PlusApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${applicationLabel}"
        android:theme="@style/AppTheme">

        <activity
            android:name=".library.LibraryActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Frontends (Cocoon, iiSU, ES-DE, ...) and file managers open games
             here: the ROM comes as the intent's data or a rom/ROM/path/file
             extra, and this hands it to the player and finishes (see
             LaunchActivity). The VIEW filter is for "Open with" and launchers
             that pick a local MIME handler. A MIME-only filter accepts content/file
             URIs; its pathPattern is ignored without scheme and host. ROM extension
             checks therefore happen in LaunchActivity and its resolver. -->
        <activity
            android:name=".library.LaunchActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Launch">
            <!-- This is the inherited local-file/content-URI handler, not an HTTP App Link.
                 LaunchActivity validates the ROM; explicit frontend VIEW intents use the same entry. -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.gba" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.gb" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.gbc" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.zip" />
            </intent-filter>
        </activity>

        <activity android:name=".settings.SettingsActivity" android:exported="false" />
        <activity android:name=".artwork.ArtworkActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".settings.RomFoldersActivity" android:exported="false" />
        <activity android:name=".settings.AboutActivity" android:exported="false" />
        <activity android:name=".companion.builder.AutomaticCompanionActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />
        <activity android:name=".settings.SaveFolderActivity" android:exported="false" />
        <activity android:name=".settings.ControllerActivity" android:exported="false" />
        <activity android:name=".settings.GameSettingsActivity" android:exported="false" />
        <activity android:name=".settings.ScrapingActivity" android:exported="false" />
        <activity android:name=".settings.ProvidersActivity" android:exported="false" />
        <activity android:name=".settings.ArtworkFolderActivity" android:exported="false" />
        <activity android:name=".settings.SteamGridDbActivity" android:exported="false" />
        <activity android:name=".settings.ArtworkPickerActivity" android:exported="false" />
        <activity android:name=".settings.PackCatalogActivity" android:exported="false" />
        <activity android:name=".settings.ButtonMappingActivity" android:exported="false" />
        <activity android:name=".settings.HotkeysActivity" android:exported="false" />
        <activity android:name=".settings.RetroAchievementsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".player.PlayerActivity"
            android:launchMode="singleTask"
            android:configChanges="${playerConfigChanges}"
            android:exported="false"
            android:screenOrientation="${playerOrientation}" />

        <!-- The companion screen on the main display, when the game was opened on the second one. -->
        <activity
            android:name=".companion.CompanionActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.companion" />
    </application>

</manifest>
